# Copy to .env and fill in. NEVER commit .env or service-account credentials.
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8100,http://localhost,https://localhost,capacitor://localhost
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set FIREBASE_SERVICE_ACCOUNT to the full service-account JSON as a secret.
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
